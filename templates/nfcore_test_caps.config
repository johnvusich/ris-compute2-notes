// Restore nf-core test-profile caps when another -c config sets process.resourceLimits.
// A later -c file REPLACES the profile's resourceLimits (it doesn't take the minimum):
// with siteman_condo.config alone, rnaseq -profile test gets cpus:64, memory:256 GB, time:2d.
// Values = nf-core/rnaseq 3.26.0 'test' profile. Load LAST:  ... -c siteman_condo.config -c nfcore_test_caps.config
process {
    resourceLimits = [ cpus: 4, memory: 15.GB, time: 1.h ]
}

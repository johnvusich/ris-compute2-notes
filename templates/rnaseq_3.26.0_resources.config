// Resource-only overrides for nf-core/rnaseq 3.26.0 real runs (any partition; written for condo-siteman).
// Measured on a 6-library mouse GRCm39 run, ~31 M read pairs each, star_salmon (2026-11-01, see docs/08).
// Changes CPU/memory requests only, no tool arguments. Put it after the cluster config with -c;
// check with: nextflow -c <global> -c <cluster> -c this config nf-core/rnaseq -profile apptainer
process {
    // RSeQC scripts are single-threaded Python (~100% CPU, <=7.6 GB RSS). Default process_medium = 6 CPU / 36 GB.
    withName: '.*:RSEQC_.*' {
        cpus   = 2
        memory = { 12.GB * task.attempt }
    }
    // Qualimap rnaseq: ~103% CPU, 19.5 GB RSS at ~31 M pairs. Default 6 CPU / 36 GB.
    withName: '.*:QUALIMAP_RNASEQ' {
        cpus   = 2
        memory = { 24.GB * task.attempt }
    }
    // Picard MarkDuplicates: ~105% CPU, 19.3 GB RSS. Default 6 CPU / 36 GB.
    withName: '.*:PICARD_MARKDUPLICATES' {
        cpus   = 2
        memory = { 24.GB * task.attempt }
    }
    // Trim Galore: 3.26.0 already sets 8 CPU (uses ~2.4); RSS <200 MB. Only memory changes (default 36 GB).
    withName: '.*:TRIMGALORE' {
        cpus   = 8
        memory = { 16.GB * task.attempt }
    }
}

// =============================================================================
// Global Nextflow config for RIS Compute2
// Location: ~/.config/nextflow/nextflow.config
// Always pass explicitly:  nextflow run ... -c ~/.config/nextflow/nextflow.config
// (Nextflow does NOT auto-load this path; it auto-loads ~/.nextflow/config,
//  the pipeline's nextflow.config, and a nextflow.config in the launch dir.)
//
// Cluster settings only. Pipeline parameters go in each analysis's params.yaml.
// =============================================================================

process {
    executor       = 'slurm'
    queue          = 'general-cpu'
    clusterOptions = '--account=compute2-sheila.stewart'

    // Cap any single task's request (adjust to partition limits:
    //   scontrol show partition general-cpu)
    resourceLimits = [ cpus: 32, memory: 256.GB, time: 48.h ]
}

executor {
    queueSize       = 50          // max pipeline jobs queued at once
    submitRateLimit = '10/1min'   // be polite to the scheduler
}

apptainer {
    enabled     = true
    autoMounts  = true
    runOptions  = '--bind /storage3,/scratch2'
    cacheDir    = '/storage3/fs1/sheila.stewart/Active/john.v/apptainer_cache'
    pullTimeout = '1h'            // REQUIRED on Nextflow 25.10.0 (null pullTimeout bug)
}

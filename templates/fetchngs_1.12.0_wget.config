// fetchngs 1.12.0, --download_method ftp, on Compute2 (Apptainer):
// the pipeline's wget image (biocontainers/wget:1.20.1) has a dangling /etc/resolv.conf symlink,
// so Apptainer can't bind the host's DNS config and wget fails with
// "unable to resolve host address 'ftp.sra.ebi.ac.uk'" (exit 4).
// Use the image fetchngs 1.13.0 switched to (PR #380, issue #373). See docs/07_pipeline_tests.md (T4).
// Pass after the global config:  -c fetchngs_1.12.0_wget.config

process {
    withName: 'SRA_FASTQ_FTP' {
        container = 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/29/2938c24ccc7875ffddf253ead323193a509f0061884a05f43224bb25d9d85b12/data'
    }
}

// =============================================================================
// Send Nextflow tasks to the Siteman condo instead of general-cpu.
// Load AFTER the global config (later -c files win):
//   nextflow run ... -c ~/.config/nextflow/nextflow.config -c siteman_condo.config
// Tested 2026-10-16, see docs/07_pipeline_tests.md (T5) and docs/09_siteman_condo.md.
// =============================================================================

process {
    executor       = 'slurm'
    queue          = 'condo-siteman'
    // Same account as general. Don't add --qos=condo-siteman-qos: "Invalid qos specification".
    clusterOptions = '--account=compute2-sheila.stewart'

    // condo-siteman's DefaultTime is 28 days (general-cpu: 8 h). nf-core processes set their
    // own time; this only covers processes that don't (e.g. nextflow-io/hello).
    time           = '1h'

    // The condo is ONE node (512 CPUs = 256 cores x 2 threads, ~1.33 TiB) shared by ~13 labs,
    // with no per-user limits. Cap single tasks so one run can't take the whole node.
    resourceLimits = [ cpus: 64, memory: 256.GB, time: 48.h ]
}
